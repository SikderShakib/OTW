rules_version = '2';

// ════════════════════════════════════════════════════════════
//  OTW — Firestore Security Rules
//  Paste this into: Firebase Console → Firestore Database →
//  Rules → Publish.  (See CLOUD_SETUP.md)
//
//  Data model:
//    /roles/{uid}     → { email, role }   role: admin | treasurer | viewer | pending
//    /appdata/main    → the whole app state (settings, members, transactions)
//
//  • Anyone can create an account, but new users start as
//    "pending" and CANNOT read or write any data.
//  • An admin approves people by changing their role
//    (in the app: Settings → Team Access, or in this console).
//  • Only admin + treasurer can modify data; viewers are read-only.
// ════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleDocExists(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid));
    }

    function myRole() {
      return (signedIn() && roleDocExists(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
        : 'none';
    }

    function isAdmin()   { return myRole() == 'admin'; }
    function canRead()   { return myRole() in ['admin', 'treasurer', 'viewer']; }
    function canWrite()  { return myRole() in ['admin', 'treasurer']; }

    // ── User roles ──────────────────────────────────────────
    match /roles/{uid} {
      // A user can read their own role; admins can read anyone's.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Only admins can list the whole team.
      allow list: if isAdmin();
      // On first sign-in the app creates the user's own role doc,
      // but ONLY with role = "pending" (no self-promotion possible).
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      // Only admins may change or remove roles.
      allow update, delete: if isAdmin();
    }

    // ── Application data ────────────────────────────────────
    match /appdata/{docId} {
      allow read: if canRead();
      allow write: if canWrite();
    }
  }
}
